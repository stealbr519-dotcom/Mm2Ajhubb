        { Size = UDim2.new(0, 6, 1, 0),  Position = UDim2.new(1, -6, 0, 0) },
    }
    for _, b in ipairs(borders) do
        local zone = Instance.new("TextButton")
        zone.Size = b.Size
        zone.Position = b.Position
        zone.BackgroundTransparency = 1
        zone.Text = ""
        zone.AutoButtonColor = false
        zone.ZIndex = 10
        zone.Parent = main
        zone.InputBegan:Connect(startDrag)
        zone.InputChanged:Connect(updateDrag)
    end
    UIS.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            dragInput = nil
        end
    end)
end

