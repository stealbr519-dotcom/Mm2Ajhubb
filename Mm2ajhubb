UserInputService.JumpRequest:Connect(function()
    IsJumping = true
    task.wait(0.5)
    IsJumping = false
end)

Mouse.Button1Down:Connect(function()
    if not BombJumpEnabled then return end
    if not IsJumping then return end
    
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoidRootPart or not humanoid then return end
    
    -- Check if on ground before bomb jumping
    if humanoid.FloorMaterial ~= Enum.Material.Air then return end
    
    -- Calculate bomb jump direction (opposite of look direction, slightly up)
    local lookVector = Camera.CFrame.LookVector
    local bombDirection = (-lookVector + Vector3.new(0, 0.8, 0)).Unit
    
    -- Apply velocity for bomb jump effect (no teleport!)
    local bombPower = 120
    humanoidRootPart.Velocity = bombDirection * bombPower
    
    -- Visual effect
    local explosion = Instance.new("ParticleEmitter")
    explosion.Texture = "rbxassetid://258128463"
    explosion.Rate = 100
    explosion.Lifetime = NumberRange.new(0.5)
    explosion.Speed = NumberRange.new(10)
    explosion.Size = NumberSequence.new(2, 0)
    explosion.Color = ColorSequence.new(Color3.fromRGB(255, 100, 0))
    explosion.Parent = humanoidRootPart
    
    game:GetService("Debris"):AddItem(explosion, 0.5)
end)

-- Aimbot Function
local function GetMurderer()
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local role = GetPlayerRole(player)
        if role == "Murderer" then
            return player
        end
    end
    return nil
end

local function IsVisible(targetPosition)
    local origin = Camera.CFrame.Position
    local direction = (targetPosition - origin)
    local distance = direction.Magnitude
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    
    local result = Workspace:Raycast(origin, direction.Unit * distance, raycastParams)
    
    return result == nil
end

local function AimAt(target)
    if not target or not target.Character then return end
    local targetPart = target.Character:FindFirstChild("HumanoidRootPart") or target.Character:FindFirstChild("Head")
    if not targetPart then return end
    
    local targetPosition = targetPart.Position
    
    -- Check wall visibility - only aim if visible
    if not IsVisible(targetPosition) then return end
    
    -- Smooth aim
    local currentCF = Camera.CFrame
    local targetCF = CFrame.new(currentCF.Position, targetPosition)
    
    Camera.CFrame = currentCF:Lerp(targetCF, 0.3)
end

-- Aimbot Hold Button
local Aiming = false

AimbotButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        Aiming = true
        AimbotButton.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
    end
end)

AimbotButton.InputEnded:Connect(function(input)
