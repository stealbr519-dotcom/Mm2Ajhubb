    btn.TextSize = 13
    btn.AutoButtonColor = false
    btn.Parent = sidebar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local frame = Instance.new("Frame")
    frame.Name = name .. "Content"
    frame.Size = UDim2.new(1, 0, 0, 0)
    frame.AutomaticSize = Enum.AutomaticSize.Y
    frame.BackgroundTransparency = 1
    frame.Visible = false
    frame.Parent = content

    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 6)
    list.Parent = frame

    tabs[name] = { button = btn, frame = frame, list = list }

    btn.MouseButton1Click:Connect(function()
        for n, t in pairs(tabs) do
            t.button.BackgroundColor3 = ROW
            t.button.TextColor3 = TEXT_DIM
            t.frame.Visible = false
        end
        btn.BackgroundColor3 = ACCENT_DIM
        btn.TextColor3 = TEXT
        frame.Visible = true
    end)
end

local function selectTab(name)
    for n, t in pairs(tabs) do
        t.button.BackgroundColor3 = ROW
        t.button.TextColor3 = TEXT_DIM
        t.frame.Visible = false
    end
    if tabs[name] then
        tabs[name].button.BackgroundColor3 = ACCENT_DIM
        tabs[name].button.TextColor3 = TEXT
        tabs[name].frame.Visible = true
    end
end

