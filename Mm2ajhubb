local GunDropSection = CombatPage:addSection({ title = "GunDrop ESP" })
local gunDropEnabled = false
local gunDropColor = Color3.fromRGB(0, 200, 255)
local gunDropObjects = {}
local gunDropGui = nil

local function isGunDrop(obj)
    if not obj then return false end
    local n = string.lower(obj.Name)
    return string.find(n, "gundrop") or string.find(n, "drop")
end

local function getGunDropPos(obj)
    local p = obj:FindFirstChild("PrimaryPart")
    if p then return p.Position end
    local part = obj:FindFirstChildOfClass("BasePart")
    if part then return part.Position end
    if obj:IsA("BasePart") then return obj.Position end
    for _, c in ipairs(obj:GetChildren()) do
        if c:IsA("BasePart") then return c.Position end
    end
    return nil
end

local function createGunDrop(obj)
    if gunDropObjects[obj] then return end
    if not obj or not obj.Parent then return end
    if not getGunDropPos(obj) then return end

    if not gunDropGui then
        gunDropGui = Instance.new("ScreenGui")
        gunDropGui.Name = "AJHUB_GunDrop"
        gunDropGui.Parent = LocalPlayer.PlayerGui
        gunDropGui.ResetOnSpawn = false
    end

    local hl = Instance.new("Highlight")
    hl.Parent = obj
    hl.FillColor = gunDropColor
    hl.FillTransparency = 0.4
    hl.OutlineColor = gunDropColor
    hl.OutlineTransparency = 0.2
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 150, 0, 25)
    frame.BackgroundTransparency = 1
    frame.Parent = gunDropGui

    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, 0, 1, 0)
    t.BackgroundTransparency = 1
    t.Text = "GunDrop"
    t.TextColor3 = gunDropColor
    t.TextSize = 14
    t.Font = Enum.Font.GothamBold
    t.TextStrokeTransparency = 0.3
    t.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    t.Parent = frame

    gunDropObjects[obj] = { Highlight = hl, Frame = frame }
    obj.AncestryChanged:Connect(function(_, parent)
        if parent == nil and gunDropObjects[obj] then
            local d = gunDropObjects[obj]
            if d.Highlight then d.Highlight:Destroy() end
            if d.Frame then d.Frame:Destroy() end
            gunDropObjects[obj] = nil
        end
    end)
end

local function clearGunDrop()
    for obj, d in pairs(gunDropObjects) do
        if d.Highlight then d.Highlight:Destroy() end
        if d.Frame then d.Frame:Destroy() end
    end
    gunDropObjects = {}
    if gunDropGui then gunDropGui:Destroy(); gunDropGui = nil end
end

RunService.RenderStepped:Connect(function()
    if not gunDropEnabled then return end
    for obj, d in pairs(gunDropObjects) do
        local frame = d.Frame
        if not frame then continue end
        if not obj or not obj.Parent then frame.Visible = false; continue end
        local pos = getGunDropPos(obj)
        if not pos then frame.Visible = false; continue end
        local sp, onScreen = camera:WorldToScreenPoint(pos)
        if onScreen then
            frame.Position = UDim2.new(0, sp.X - 75, 0, sp.Y - 15)
            frame.Visible = true
        else frame.Visible = false end
    end
end)

