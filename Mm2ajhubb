-- Respawn handling
LocalPlayer.CharacterAdded:Connect(function()
    farmFullNotif = nil
    farmCoinsText = nil
    farmFullIcon = nil
    farmEmptyIcon = nil
    farmContainer = nil
    farmCollectedCoins = {}
    farmRunning = false
    task.wait(1)
    findFarmBagUI()

    if not farmResuming then
        farmStatusLabel.Text = "Status: respawned (farm off)"
        return
    end

    farmStatusLabel.Text = "Status: waiting for new round..."
    local waited = 0
    local ready = false
    while waited < 120 do
        task.wait(1)
        waited = waited + 1
        if farmRunning then return end
        if not farmResuming then return end
        local char = LocalPlayer.Character
        local hasChar = char and char:FindFirstChild("HumanoidRootPart")
        if hasChar and getFarmNearestDist() < FARM_MAX_DIST then
            ready = true
            break
        end
    end

    if ready then
        farmStatusLabel.Text = "Status: new round — resuming"
        farmCollectedThisRun = 0
        farmCollectedCoins = {}
        farmRunning = true
        farmToggleBtn.Text = "STOP AUTO FARM"
        farmToggleBtn.BackgroundColor3 = ACCENT_DIM
        task.spawn(farmLoop)
    else
        farmStatusLabel.Text = "Status: no round started"
    end
end)

