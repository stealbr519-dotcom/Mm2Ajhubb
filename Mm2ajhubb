addSection("Player", "Anti Fling")

local antiFlingEnabled = false
local antiFlingConnection = nil
local ANGULAR_THRESHOLD = 50
local LINEAR_THRESHOLD = 500
local TELEPORT_THRESHOLD = 100

local function startAntiFling()
    if antiFlingConnection then antiFlingConnection:Disconnect() end
    local lastPos = nil
    antiFlingConnection = RunService.Heartbeat:Connect(function()
        if not antiFlingEnabled then return end
        local char = LocalPlayer.Character
        if not char then lastPos = nil; return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then lastPos = nil; return end
        for _, child in ipairs(hrp:GetChildren()) do
            if child:IsA("BodyVelocity") or child:IsA("BodyAngularVelocity") or child:IsA("BodyGyro") or child:IsA("BodyThrust") then
                child:Destroy()
            end
        end
        local angVel = hrp.AssemblyAngularVelocity
        if angVel.Magnitude > ANGULAR_THRESHOLD then
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
        local linVel = hrp.AssemblyLinearVelocity
        if linVel.Magnitude > LINEAR_THRESHOLD then
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
        if lastPos then
            local dist = (hrp.Position - lastPos).Magnitude
            if dist > TELEPORT_THRESHOLD then
                hrp.CFrame = CFrame.new(lastPos)
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
        end
        lastPos = hrp.Position
    end)
end

local function stopAntiFling()
    if antiFlingConnection then antiFlingConnection:Disconnect(); antiFlingConnection = nil end
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            for _, child in ipairs(hrp:GetChildren()) do
                if child:IsA("BodyVelocity") or child:IsA("BodyAngularVelocity") or child:IsA("BodyGyro") or child:IsA("BodyThrust") then
                    child:Destroy()
                end
            end
        end
    end
end

addToggleRow(tabs.Player.frame, "Anti Fling", false, function(v)
    antiFlingEnabled = v
    if v then startAntiFling() else stopAntiFling() end
end)
