local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()
local Camera = Workspace.CurrentCamera

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "SimpleMM2"
ScreenGui.Parent = game.CoreGui

-- Button creation function
local function CreateButton(name, text, position, color)
    local button = Instance.new("TextButton")
    button.Name = name
    button.Size = UDim2.new(0, 100, 0, 40)
    button.Position = position
    button.BackgroundColor3 = color or Color3.fromRGB(80, 80, 80)
    button.Text = text
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextSize = 14
    button.Font = Enum.Font.SourceSansBold
    button.BorderSizePixel = 2
    button.BorderColor3 = Color3.new(1, 1, 1)
    button.Parent = ScreenGui
    button.Active = true
    button.Draggable = false
    return button
end

-- Create buttons
local ESPButton = CreateButton("ESP", "ESP: OFF", UDim2.new(0, 10, 0, 10), Color3.fromRGB(80, 80, 80))
local AimbotButton = CreateButton("Aimbot", "Shoot Murderer", UDim2.new(0, 10, 0, 60), Color3.fromRGB(80, 80, 80))
local BombButton = CreateButton("BombJump", "Bomb: OFF", UDim2.new(0, 10, 0, 110), Color3.fromRGB(80, 80, 80))
local LockButton = CreateButton("Lock", "Lock", UDim2.new(0, 10, 0, 160), Color3.fromRGB(0, 150, 0))

local buttons = {ESPButton, AimbotButton, BombButton, LockButton}
local locked = true
local dragging = nil
local dragStart = nil
local startPos = nil

-- Dragging system
for _, button in pairs(buttons) do
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and not locked then
            dragging = button
            dragStart = input.Position
            startPos = button.Position
        end
    end)
end

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        dragging.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = nil
    end
end)

-- Lock/Unlock
LockButton.MouseButton1Click:Connect(function()
    locked = not locked
    LockButton.Text = locked and "Lock" or "Unlock"
    LockButton.BackgroundColor3 = locked and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(150, 0, 0)
end)

-- ESP System
local ESPEnabled = false
local highlights = {}

local function GetRole(player)
    if player == LocalPlayer then return nil end
    local char = player.Character
    if not char then return nil end
    
    local backpack = player:FindFirstChild("Backpack")
    local hasKnife = char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife"))
    local hasGun = char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun"))
    
    if hasKnife then return "Murderer", Color3.fromRGB(255, 0, 0)
    elseif hasGun then return "Sheriff", Color3.fromRGB(0, 100, 255)
    else return "Innocent", Color3.fromRGB(0, 255, 0) end
end

local function CreateESP(player)
    if highlights[player] then return end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "MM2ESP"
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = false
    highlight.Parent = Workspace
    
    highlights[player] = highlight
    
    local function update()
        if not player.Parent then
            highlight:Destroy()
            highlights[player] = nil
            return
        end
        
        local char = player.Character
        if char and ESPEnabled then
            highlight.Adornee = char
            local role, color = GetRole(player)
            if role then
                highlight.FillColor = color
                highlight.OutlineColor = color
                highlight.Enabled = true
            else
                highlight.Enabled = false
            end
        else
            highlight.Enabled = false
        end
    end
    
    RunService.Heartbeat:Connect(update)
end

for _, p in pairs(Players:GetPlayers()) do CreateESP(p) end
Players.PlayerAdded:Connect(CreateESP)

ESPButton.MouseButton1Click:Connect(function()
    ESPEnabled = not ESPEnabled
    ESPButton.Text = ESPEnabled and "ESP: ON" or "ESP: OFF"
    ESPButton.BackgroundColor3 = ESPEnabled and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(80, 80, 80)
end)

-- Aimbot - Instant Shoot
local function GetMurderer()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local role = GetRole(p)
            if role == "Murderer" then return p end
        end
    end
    return nil
end

local function ShootAt(target)
    if not target or not target.Character then return end
    local targetPart = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart then return end
    
    -- Aim camera at target
    Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
    
    -- Find and activate gun
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local gun = nil
    
    if char then gun = char:FindFirstChild("Gun") end
    if not gun and backpack then gun = backpack:FindFirstChild("Gun") end
    
    if gun then
        -- Equip gun if in backpack
        if gun.Parent == backpack then
            LocalPlayer.Character.Humanoid:EquipTool(gun)
            task.wait(0.1)
        end
        
        -- Fire the gun (different methods for different MM2 versions)
        if gun:FindFirstChild("Shoot") then
            gun.Shoot:FireServer(targetPart.Position)
        elseif gun:FindFirstChild("Fire") then
            gun.Fire:FireServer(targetPart.Position)
        elseif gun:FindFirstChild("Input") then
            gun.Input:FireServer("Shoot", targetPart.Position)
        else
            -- Fallback: click at screen position of target
            local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
            if onScreen then
                mousemoverel(screenPos.X - Mouse.X, screenPos.Y - Mouse.Y)
                task.wait(0.05)
                mouse1click()
            end
        end
    end
end

AimbotButton.MouseButton1Click:Connect(function()
    local murderer = GetMurderer()
    if murderer then
        ShootAt(murderer)
        AimbotButton.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        task.wait(0.2)
        AimbotButton.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    else
        AimbotButton.Text = "No Murderer"
        task.wait(1)
        AimbotButton.Text = "Shoot Murderer"
    end
end)

-- Bomb Jump - Places Prank Bomb under you when jumping
local BombEnabled = false
local hasJumped = false

BombButton.MouseButton1Click:Connect(function()
    BombEnabled = not BombEnabled
    BombButton.Text = BombEnabled and "Bomb: ON" or "Bomb: OFF"
    BombButton.BackgroundColor3 = BombEnabled and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(80, 80, 80)
end)

local function GetPrankBomb()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    if char then
        local bomb = char:FindFirstChild("PrankBomb") or char:FindFirstChild("Prank Bomb")
        if bomb then return bomb end
    end
    if backpack then
        return backpack:FindFirstChild("PrankBomb") or backpack:FindFirstChild("Prank Bomb")
    end
    return nil
end

UserInputService.JumpRequest:Connect(function()
    if not BombEnabled then return end
    
    local bomb = GetPrankBomb()
    local char = LocalPlayer.Character
    if not bomb or not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Equip bomb if needed
    if bomb.Parent ~= char then
        char:FindFirstChild("Humanoid"):EquipTool(bomb)
        task.wait(0.1)
    end
    
    -- Place bomb under legs
    task.wait(0.05) -- Small delay to let jump start
    local bombPos = hrp.Position - Vector3.new(0, 2.5, 0)
    
    -- Activate bomb (place it)
    if bomb:FindFirstChild("Activate") then
        bomb.Activate:FireServer(bombPos)
    elseif bomb:FindFirstChild("Throw") then
        bomb.Throw:FireServer(bombPos)
    elseif bomb:FindFirstChild("Input") then
        bomb.Input:FireServer("Place", bombPos)
    end
end)

