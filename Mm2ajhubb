local farmFullNotif, farmCoinsText, farmFullIcon, farmEmptyIcon

function findFarmBagUI()
    farmFullNotif = nil
    farmCoinsText = nil
    farmFullIcon = nil
    farmEmptyIcon = nil
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return end
    for _, gui in ipairs(pg:GetChildren()) do
        if gui:IsA("ScreenGui") then
            for _, desc in ipairs(gui:GetDescendants()) do
                if desc:IsA("TextLabel") then
                    if desc.Name == "FullBagNotification" then
                        farmFullNotif = desc
                    elseif desc.Name == "Coins" then
                        farmCoinsText = desc
                    end
                elseif desc:IsA("ImageLabel") then
                    if desc.Name == "FullBagIcon" then
                        farmFullIcon = desc
                    elseif desc.Name == "EmptyBagIcon" then
                        farmEmptyIcon = desc
                    end
                end
            end
        end
    end
end

local function isFarmBagFull()
    if not farmFullIcon or not farmFullIcon.Parent then findFarmBagUI() end
    if farmFullIcon and farmFullIcon.Parent and farmEmptyIcon and farmEmptyIcon.Parent then
        if farmFullIcon.Visible and not farmEmptyIcon.Visible then
            return true
        end
    end
    if farmFullNotif and farmFullNotif.Parent then
        if farmFullNotif.Visible and (farmFullNotif.Text or ""):upper():find("FULL") then
            return true
        end
    end
    return false
end

local function readFarmCoins()
    if not farmCoinsText or not farmCoinsText.Parent then findFarmBagUI() end
    if farmCoinsText and farmCoinsText.Parent then
        return farmCoinsText.Text
    end
    return "?"
end

local farmContainer, farmMapName

function findFarmCoinContainer()
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") or obj:IsA("Folder") then
            local c = obj:FindFirstChild("CoinContainer")
            if c then
                farmContainer = c
                farmMapName = obj.Name
                return c
            end
        end
        for _, sub in ipairs(obj:GetChildren()) do
            if sub:IsA("Model") or sub:IsA("Folder") then
                local c = sub:FindFirstChild("CoinContainer")
                if c then
                    farmContainer = c
                    farmMapName = sub.Name
                    return c
                end
            end
        end
    end
    return nil
end

local function getFarmCoinPos(coin)
    if not coin or not coin.Parent then return nil end
    if coin:IsA("BasePart") then return coin.Position end
    return nil
end

local function getFarmNearestDist()
    local myChar = LocalPlayer.Character
    if not myChar then return math.huge end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return math.huge end
    if not farmContainer or not farmContainer.Parent then findFarmCoinContainer() end
    if not farmContainer then return math.huge end
    local closest = math.huge
    for _, coin in ipairs(farmContainer:GetChildren()) do
        local pos = getFarmCoinPos(coin)
        if pos then
            local d = (pos - myHRP.Position).Magnitude
            if d < closest then closest = d end
        end
    end
    return closest
end

local function farmGlideTo(coin)
    local myChar = LocalPlayer.Character
    if not myChar then return false end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return false end
    local pos = getFarmCoinPos(coin)
    if not pos then return false end
    local targetPos = pos + Vector3.new(0, -1.3, 0)
    local dist = (pos - myHRP.Position).Magnitude
    local duration = math.clamp(dist / 25, 0.1, 2.0)
    local targetCFrame = CFrame.new(targetPos) * CFrame.Angles(math.rad(-90), 0, 0)
    local tw = TweenService:Create(myHRP, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    tw:Play()
    tw.Completed:Wait()
    return true
end

function farmSelfKill()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    hrp.CFrame = CFrame.new(hrp.Position.X, -1000, hrp.Position.Z)
end

function farmLoop()
    farmStatusLabel.Text = "Status: farming..."
    while farmRunning do
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then
            farmStatusLabel.Text = "Status: no character — stopping"
            farmRunning = false
            break
        end

        if isFarmBagFull() then
            farmStatusLabel.Text = "Status: BAG FULL — resetting"
            farmRunning = false
            task.wait(0.15)
            farmSelfKill()
            break
        end

        farmCoinsLabel.Text = "Coins: " .. tostring(readFarmCoins())

        if getFarmNearestDist() > FARM_MAX_DIST then
            farmStatusLabel.Text = "Status: coins too far — waiting"
            task.wait(1)
            continue
        end

        local coin = nil
        local nearestD = math.huge
        local myHRP = char:FindFirstChild("HumanoidRootPart")
        if farmContainer and myHRP then
            for _, c in ipairs(farmContainer:GetChildren()) do
                if getFarmCoinPos(c) and not farmCollectedCoins[c] then
                    local d = (c.Position - myHRP.Position).Magnitude
                    if d < nearestD then
                        nearestD = d
                        coin = c
                    end
                end
            end
        end

        if not coin then
            farmStatusLabel.Text = "Status: all coins done — waiting"
            task.wait(0.5)
            continue
        end

        local before = tonumber(readFarmCoins()) or 0
        farmStatusLabel.Text = "Status: gliding..."
        farmGlideTo(coin)
        task.wait(0.05)
        farmCollectedCoins[coin] = true
        local after = tonumber(readFarmCoins()) or 0
        if after > before then
            farmCollectedThisRun = farmCollectedThisRun + 1
            farmProgressLabel.Text = "Progress: collected " .. farmCollectedThisRun
        end
        task.wait(0.01)
    end
    farmToggleBtn.Text = "START AUTO FARM"
    farmToggleBtn.BackgroundColor3 = ROW
end

