-- FIXED BOMB - Click to place immediately
BombBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    if not char then 
        BombBtn.Text = "NO CHARACTER"
        task.delay(1, function() BombBtn.Text = "DROP BOMB" end)
        return 
    end
    
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local bomb = nil
    
    -- Find bomb
    if char then 
        bomb = char:FindFirstChild("PrankBomb") 
            or char:FindFirstChild("Prank Bomb")
            or char:FindFirstChild("Bomb")
    end
    if not bomb and backpack then 
        bomb = backpack:FindFirstChild("PrankBomb") 
            or backpack:FindFirstChild("Prank Bomb")
            or backpack:FindFirstChild("Bomb")
    end
    
    if not bomb then
        BombBtn.Text = "NO BOMB!"
        task.delay(1, function() BombBtn.Text = "DROP BOMB" end)
        return
    end
    
    -- Equip if needed
    local humanoid = char:FindFirstChild("Humanoid")
    if bomb.Parent ~= char and humanoid then
        humanoid:EquipTool(bomb)
        task.wait(0.1)
    end
    
    -- Get position (under player)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local bombPos = hrp.Position - Vector3.new(0, 3, 0)
    
    -- Place bomb
    local placed = false
    
    -- Try different remote names
    local remotes = {"Activate", "Throw", "Place", "Drop", "Input", "RemoteEvent"}
    for _, remoteName in ipairs(remotes) do
        local remote = bomb:FindFirstChild(remoteName)
        if remote then
            pcall(function()
                if remoteName == "Input" then
                    remote:FireServer("Place", bombPos)
                elseif remoteName == "Throw" or remoteName == "Drop" then
                    remote:FireServer(bombPos)
                else
                    remote:FireServer(bombPos)
                end
                placed = true
            end)
            if placed then break end
        end
    end
    
    -- Fallback: Activate tool
    if not placed then
        pcall(function()
            bomb:Activate()
            placed = true
        end)
    end
    
    if placed then
        BombBtn.Text = "PLACED!"
        BombBtn:FindFirstChildOfClass("UIStroke").Color = Color3.fromRGB(50, 255, 100)
        task.delay(0.5, function()
            BombBtn.Text = "DROP BOMB"
            BombBtn:FindFirstChildOfClass("UIStroke").Color = Color3.fromRGB(255, 200, 50)
        end)
    else
        BombBtn.Text = "FAILED"
        task.delay(1, function() BombBtn.Text = "DROP BOMB" end)
    end
end)

