-- Auto Pick Up Gun toggle: NO floating button, just loops internally
local autoPickupEnabled = false
local autoPickupThread = nil

local function AutoPickupLoop()
    while autoPickupEnabled do
        local myChar = LocalPlayer.Character
        if myChar then
            local myHRP = myChar:FindFirstChild("HumanoidRootPart")
            if myHRP then
                local gun = findDroppedGun()
                if gun then
                    local pos = getDropPos(gun)
                    if pos then
                        local original = myHRP.CFrame
                        myHRP.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
                        task.wait(0.1)
                        local bp = LocalPlayer:FindFirstChild("Backpack")
                        pcall(function()
                            if gun:IsA("Tool") then gun.Parent = bp or myChar
                            else
                                local t = gun:FindFirstChildWhichIsA("Tool")
                                if t then t.Parent = bp or myChar
                                else gun.Parent = myChar end
                            end
                        end)
                        task.wait(0.05)
                        myHRP.CFrame = original
                    end
                end
            end
        end
        task.wait(0.1)
    end
end

StealSection:addToggle({
