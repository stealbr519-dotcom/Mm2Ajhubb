-- ESP Function
local function GetPlayerRole(player)
    local character = player.Character
    if not character then return "Unknown" end
    
    local backpack = player:FindFirstChild("Backpack")
    local knife = character:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife"))
    local gun = character:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun"))
    
    if knife then return "Murderer", Color3.fromRGB(255, 0, 0) end
    if gun then return "Sheriff", Color3.fromRGB(0, 0, 255) end
    return "Innocent", Color3.fromRGB(0, 255, 0)
end

local function CreateESP(player)
    if player == LocalPlayer then return end
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "RoleESP"
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextStrokeTransparency = 0
    label.TextSize = 20
    label.Font = Enum.Font.SourceSansBold
    label.Parent = billboard
    
    ESPObjects[player] = billboard
    
    local function Update()
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
            billboard.Enabled = false
            return
        end
        
        billboard.Adornee = player.Character.HumanoidRootPart
        local role, color = GetPlayerRole(player)
        label.Text = player.Name .. " - " .. role
        label.TextColor3 = color
        billboard.Enabled = ESPEnabled
    end
    
    RunService.RenderStepped:Connect(Update)
end

-- Initialize ESP for existing players
