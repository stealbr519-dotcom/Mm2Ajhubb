        Aiming = false
        AimbotButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    end
end)

-- Aimbot Loop
RunService.RenderStepped:Connect(function()
    if not Aiming then return end
    
    local murderer = GetMurderer()
    if murderer then
        AimAt(murderer)
    end
end)

-- Keybinds
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.E then
        ESPToggle.MouseButton1Click:Fire()
    elseif input.KeyCode == Enum.KeyCode.Q then
        BombJumpToggle.MouseButton1Click:Fire()
    elseif input.KeyCode == Enum.KeyCode.F then
        -- Toggle aimbot mode
        Aiming = not Aiming
        AimbotButton.BackgroundColor3 = Aiming and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(60, 60, 60)
    end
end)

