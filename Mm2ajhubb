-- FIXED AIMBOT - Actually shoots
local function GetMurderer()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local role = GetRoleAdvanced(p)
            if role == "Murderer" then return p end
        end
    end
    return nil
end

local function ShootTarget(target)
    if not target or not target.Character then return false end
    
    local targetPart = target.Character:FindFirstChild("Head") 
        or target.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart then return false end
    
    -- Get gun
    local char = LocalPlayer.Character
    if not char then return false end
    
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local gun = nil
    
    -- Find gun
    if char then 
        gun = char:FindFirstChild("Gun") or char:FindFirstChild("Revolver")
    end
    if not gun and backpack then 
        gun = backpack:FindFirstChild("Gun") or backpack:FindFirstChild("Revolver")
    end
    
    if not gun then 
        AimBtn.Text = "NO GUN!"
        task.delay(1, function() AimBtn.Text = "SHOOT MURDERER" end)
        return false 
    end
    
    -- Equip if needed
    if gun.Parent == backpack then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            humanoid:EquipTool(gun)
            task.wait(0.15)
        end
    end
    
    -- Re-check character after equip
    char = LocalPlayer.Character
    if not char then return false end
    
    -- Aim at target
    Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
    
    -- SHOOT - Try multiple methods
    local shot = false
    
    -- Method 1: Direct remote fire
    local shootEvent = gun:FindFirstChild("Shoot") 
        or gun:FindFirstChild("Fire") 
        or gun:FindFirstChild("ShootEvent")
        or gun:FindFirstChild("RemoteEvent")
        or gun:FindFirstChild("Input")
    
    if shootEvent then
        pcall(function()
            if shootEvent.Name == "Input" then
                shootEvent:FireServer("Shoot", targetPart.Position)
            else
                shootEvent:FireServer(targetPart.Position)
            end
            shot = true
        end)
    end
    
    -- Method 2: Activate tool
    if not shot then
        pcall(function()
            gun:Activate()
            shot = true
        end)
    end
    
    -- Method 3: Mouse click simulation (if executor supports it)
    if not shot and mouse1click then
        local screenPos = Camera:WorldToViewportPoint(targetPart.Position)
        local mousePos = UserInputService:GetMouseLocation()
        mousemoverel(screenPos.X - mousePos.X, screenPos.Y - mousePos.Y)
        task.wait(0.05)
        mouse1click()
        shot = true
    end
    
    return shot
end

