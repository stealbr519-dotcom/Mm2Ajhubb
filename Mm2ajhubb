-- FIXED ESP SYSTEM - Uses multiple detection methods
local ESPEnabled = false
local ESPData = {}
local RoleCache = {}

-- Check role using multiple methods (MM2 specific)
local function GetRoleAdvanced(player)
    if player == LocalPlayer then return nil end
    
    -- Method 1: Check backpack/character for tools
    local char = player.Character
    if not char then return nil end
    
    local backpack = player:FindFirstChild("Backpack")
    local hasKnife = char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife"))
    local hasGun = char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun"))
    
    if hasKnife then return "Murderer", Color3.fromRGB(255, 0, 50)
    elseif hasGun then return "Sheriff", Color3.fromRGB(0, 150, 255)
    end
    
    -- Method 2: Check leaderstats (some MM2 versions store roles here)
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local role = leaderstats:FindFirstChild("Role")
        if role then
            if role.Value == "Murderer" then return "Murderer", Color3.fromRGB(255, 0, 50)
            elseif role.Value == "Sheriff" then return "Sheriff", Color3.fromRGB(0, 150, 255)
            elseif role.Value == "Innocent" then return "Innocent", Color3.fromRGB(50, 255, 100)
            end
        end
    end
    
    -- Method 3: Check for role value in player
    local roleVal = player:FindFirstChild("Role")
    if roleVal and roleVal:IsA("StringValue") then
        if roleVal.Value == "Murderer" then return "Murderer", Color3.fromRGB(255, 0, 50)
        elseif roleVal.Value == "Sheriff" then return "Sheriff", Color3.fromRGB(0, 150, 255)
        elseif roleVal.Value == "Innocent" then return "Innocent", Color3.fromRGB(50, 255, 100)
        end
    end
    
    -- Method 4: Check for specific clothing/assets (aggressive detection)
    -- Murderers often have specific appearance changes
    if char:FindFirstChild("Humanoid") then
        -- Check shirt/pants for murderer indicators
        local shirt = char:FindFirstChildOfClass("Shirt")
        local pants = char:FindFirstChildOfClass("Pants")
        
        -- Default to Innocent if we see them but no weapon (they might be hiding it)
        -- Only show if we've seen them as murderer before (cached)
        if RoleCache[player] then
            return RoleCache[player], 
                RoleCache[player] == "Murderer" and Color3.fromRGB(255, 0, 50) or
                RoleCache[player] == "Sheriff" and Color3.fromRGB(0, 150, 255) or
                Color3.fromRGB(50, 255, 100)
        end
    end
    
    return "Innocent", Color3.fromRGB(50, 255, 100) -- Default assumption
end

local function CleanupESP(player)
    if ESPData[player] then
        if ESPData[player].highlight and ESPData[player].highlight.Parent then
            ESPData[player].highlight:Destroy()
        end
        if ESPData[player].connection then
            ESPData[player].connection:Disconnect()
        end
        ESPData[player] = nil
    end
end

local function CreateESP(player)
    CleanupESP(player)
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "MM2ESP_" .. player.Name
    highlight.FillTransparency = 0.6
    highlight.OutlineTransparency = 0
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = false
    highlight.Parent = Workspace
    
    ESPData[player] = {
        highlight = highlight,
        lastUpdate = 0
    }
    
    -- Update loop
    local conn = RunService.Heartbeat:Connect(function()
        if not player.Parent then
            CleanupESP(player)
            return
        end
        
        if not ESPEnabled then
            highlight.Enabled = false
            return
        end
        
        local char = player.Character
        if char then
            local role, color = GetRoleAdvanced(player)
            
            -- Cache the role if it's important
            if role == "Murderer" or role == "Sheriff" then
                RoleCache[player] = role
            end
            
            highlight.Adornee = char
            highlight.FillColor = color
            highlight.Enabled = true
            
            -- Add name tag if doesn't exist
            if not char:FindFirstChild("ESPNameTag") then
                local billboard = Instance.new("BillboardGui")
                billboard.Name = "ESPNameTag"
                billboard.Size = UDim2.new(0, 100, 0, 20)
                billboard.StudsOffset = Vector3.new(0, 3, 0)
                billboard.AlwaysOnTop = true
                
                local text = Instance.new("TextLabel")
                text.Size = UDim2.new(1, 0, 1, 0)
                text.BackgroundTransparency = 1
                text.Text = player.Name .. "\n[" .. role .. "]"
                text.TextColor3 = color
                text.TextSize = 12
                text.Font = Enum.Font.GothamBold
                text.Parent = billboard
                
                billboard.Parent = char
            else
                local tag = char:FindFirstChild("ESPNameTag")
                if tag then
                    local text = tag:FindFirstChildOfClass("TextLabel")
                    if text then
                        text.Text = player.Name .. "\n[" .. role .. "]"
                        text.TextColor3 = color
                    end
                end
            end
        else
            highlight.Enabled = false
        end
    end)
    
    ESPData[player].connection = conn
end

-- Initialize ESP
for _, p in pairs(Players:GetPlayers()) do
    CreateESP(p)
end

Players.PlayerAdded:Connect(CreateESP)
Players.PlayerRemoving:Connect(CleanupESP)

