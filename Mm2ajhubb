local ESPEnabled = true
local showGun = true
local showKnife = true
local showNone = true
local GunColor = Color3.fromRGB(0, 100, 255)
local KnifeColor = Color3.fromRGB(255, 0, 0)
local NoneColor = Color3.fromRGB(0, 255, 0)
local FillTransparency = 0.5
local OutlineTransparency = 0.2

local weaponCache = {}
local espObjects = {}
local espScreenGui = Instance.new("ScreenGui")
espScreenGui.Name = "AJHUB_ESP"
espScreenGui.Parent = LocalPlayer.PlayerGui

local function updateWeaponCache(plr)
    if plr == LocalPlayer then weaponCache[plr] = nil; return end
    local found = nil
    local backpack = plr:FindFirstChild("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                local n = string.lower(item.Name)
                if string.find(n, "gun") then found = "Gun"; break
                elseif string.find(n, "knife") then found = "Knife"; break end
            end
        end
    end
    if not found and plr.Character then
        for _, item in ipairs(plr.Character:GetChildren()) do
            if item:IsA("Tool") then
                local n = string.lower(item.Name)
                if string.find(n, "gun") then found = "Gun"; break
                elseif string.find(n, "knife") then found = "Knife"; break end
            end
        end
    end
    weaponCache[plr] = found
end

local function refreshCache()
    for _, plr in ipairs(Players:GetPlayers()) do updateWeaponCache(plr) end
end

local function getInfo(plr)
    local t = weaponCache[plr]
    if t == "Gun" then return GunColor, plr.Name .. " [Gun]", "Gun"
    elseif t == "Knife" then return KnifeColor, plr.Name .. " [Knife]", "Knife"
    else return NoneColor, plr.Name .. " [None]", "None" end
end

local function removeESP(plr)
    if espObjects[plr] then
        if espObjects[plr].Highlight then espObjects[plr].Highlight:Destroy() end
        if espObjects[plr].Frame then espObjects[plr].Frame:Destroy() end
        espObjects[plr] = nil
    end
end

local function createESP(plr)
    removeESP(plr)
    if not plr.Character then return end
    local color, text, itemType = getInfo(plr)
    if (itemType == "Gun" and not showGun) or (itemType == "Knife" and not showKnife) or (itemType == "None" and not showNone) then return end

    local hl = Instance.new("Highlight")
    hl.Parent = plr.Character
    hl.FillColor = color
    hl.FillTransparency = FillTransparency
    hl.OutlineColor = color
    hl.OutlineTransparency = OutlineTransparency
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 200, 0, 30)
    frame.BackgroundTransparency = 1
    frame.Parent = espScreenGui

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = color
    label.TextSize = 16
    label.Font = Enum.Font.GothamBold
    label.TextStrokeTransparency = 0.3
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Parent = frame

    espObjects[plr] = { Highlight = hl, Frame = frame }
end

function updateESP()
    if not ESPEnabled then
        for p, d in pairs(espObjects) do
            if d.Highlight then d.Highlight:Destroy() end
            if d.Frame then d.Frame:Destroy() end
        end
        espObjects = {}
        weaponCache = {}
        return
    end
    refreshCache()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            if not plr.Character then
                if espObjects[plr] then removeESP(plr) end
            else
                local _, _, itemType = getInfo(plr)
                local shouldShow = not ((itemType == "Gun" and not showGun) or (itemType == "Knife" and not showKnife) or (itemType == "None" and not showNone))
                if shouldShow then
                    if not espObjects[plr] then createESP(plr)
                    else
                        local oldColor = espObjects[plr].Highlight.FillColor
                        local newColor = getInfo(plr)
                        if oldColor ~= newColor then createESP(plr) end
                    end
                else
                    if espObjects[plr] then removeESP(plr) end
                end
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    if not ESPEnabled then return end
    for plr, data in pairs(espObjects) do
        local frame = data.Frame
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = plr.Character.HumanoidRootPart
            local headPos = hrp.Position + Vector3.new(0, 3.5, 0)
            local sp, onScreen = camera:WorldToScreenPoint(headPos)
            if onScreen then
                frame.Position = UDim2.new(0, sp.X - 100, 0, sp.Y - 15)
                frame.Visible = true
            else frame.Visible = false end
        else frame.Visible = false end
    end
end)

