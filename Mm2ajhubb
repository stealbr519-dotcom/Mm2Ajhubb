    aimbotEnabled = v
    if v then
        if aimbotConnection then aimbotConnection:Disconnect() end
        aimbotConnection = RunService.Heartbeat:Connect(aimbotLoop)
        createFloat("Aimlock", "AIM", Color3.fromRGB(255, 60, 60), function()
            aimLocked = not aimLocked
            if aimLocked then
                aimbotTarget = findMurderer()
            else
                aimbotTarget = nil
            end
            updateAimLockVisual()
        end)
    else
        if aimbotConnection then aimbotConnection:Disconnect(); aimbotConnection = nil end
        aimbotTarget = nil
        aimLocked = false
        destroyFloat("Aimlock")
    end
end)
